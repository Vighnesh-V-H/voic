DATABASE_URL=
SESSION_COOKIE_NAME=
SESSION_TTL_SECONDS=
COOKIE_SECURE=
CORS_ORIGINS=
FRONTEND_URL=
STRIPE_CLIENT_ID=
STRIPE_PLATFORM_SECRET_KEY=
STRIPE_OAUTH_REDIRECT_URI=
STRIPE_OAUTH_SCOPE=
STRIPE_MODE=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Optional local fallback when Stripe forwards an account-level event without
# an account/context envelope. Leave empty for a platform Connect webhook.
STRIPE_WEBHOOK_ACCOUNT_ID=
# Vobiz outbound calling for failed-payment recovery. Leave all empty to
# disable call triggers (webhooks keep working, trigger logs and skips).
# Values come from https://console.vobiz.ai (Auth ID + Auth Token) and a
# purchased voice-enabled DID number. Never commit real values.
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
# Vobiz caller ID (DID, e.g. +919876543210) shown to the customer.
VOBIZ_CALLER_ID=
# Public HTTPS URL serving the Voice XML flow when the call connects.
VOBIZ_ANSWER_URL=
# Public HTTPS base of this backend (ngrok URL in local dev). The trigger
# builds per-call answer/hangup URLs under this base so each call carries
# its payment context. Must be reachable from Vobiz's servers.
VOBIZ_PUBLIC_BASE_URL=
# Long random string generated once per deployment (e.g. openssl rand -hex 32).
# Embedded in our per-call callback URLs; the answer/hangup endpoints accept
# only requests carrying it, since Vobiz posts cannot carry custom headers.
VOICE_CALLBACK_TOKEN=
