DATABASE_URL=
SESSION_COOKIE_NAME=
SESSION_TTL_SECONDS=
COOKIE_SECURE=
CORS_ORIGINS=
FRONTEND_URL=
STRIPE_CLIENT_ID=
STRIPE_PLATFORM_SECRET_KEY=
STRIPE_OAUTH_REDIRECT_URI=
STRIPE_OAUTH_SCOPE=
STRIPE_MODE=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Optional local fallback when Stripe forwards an account-level event without
# an account/context envelope. Leave empty for a platform Connect webhook.
STRIPE_WEBHOOK_ACCOUNT_ID=
# Vobiz outbound calling for failed-payment recovery. Leave all empty to
# disable call triggers (webhooks keep working, trigger logs and skips).
# Values come from https://console.vobiz.ai (Auth ID + Auth Token) and a
# purchased voice-enabled DID number. Never commit real values.
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
# Vobiz caller ID (DID, e.g. +919876543210) shown to the customer.
VOBIZ_CALLER_ID=
# Legacy static answer URL. Recovery calls use a per-payment URL built from
# VOBIZ_PUBLIC_BASE_URL instead; leave this empty.
VOBIZ_ANSWER_URL=
# Public HTTPS base of this backend (ngrok URL in local dev). The trigger
# builds per-call answer/hangup URLs under this base so each call carries
# its payment context. Must be reachable from Vobiz's servers.
VOBIZ_PUBLIC_BASE_URL=
# Long random string generated once per deployment (e.g. openssl rand -hex 32).
# Used to sign the payment and call-attempt context in callback URLs; the
# secret itself is never sent to Vobiz or exposed in a callback URL.
VOICE_CALLBACK_TOKEN=
# DEMO ONLY: also trigger the call on successful payments (checkout
# session completed), where the customer phone collected at checkout is
# reliably present. Production keeps the FAILED-only rule; leave false.
VOICE_DEMO_SUCCESS_TRIGGER=
# ElevenLabs conversational voice agent (ElevenLabs talks, Voic decides and
# executes, Vobiz connects the call). Leave all empty to disable the agent
# path (webhooks and the static Vobiz flow keep working).
# Values come from https://elevenlabs.io/app/agents (API key + agent ID) and
# the agent's Phone Numbers page (SIP-trunk number ID). Never commit real values.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# ID of the Vobiz DID imported into ElevenLabs as a SIP-trunk phone number
# and assigned to the agent (see backend README for the trunk setup).
ELEVENLABS_PHONE_NUMBER_ID=
# Long random string generated once per deployment (e.g. openssl rand -hex 32).
# Shared secret the ElevenLabs agent sends on every Voic tool call; the
# backend rejects tool requests without it.
AGENT_TOOL_TOKEN=
# Public base URL for the Vobiz media-stream WebSocket (no trailing slash),
# e.g. wss://<ngrok-host> in local dev. Vobiz opens
# <VOICE_WS_BASE_URL>/ws/voice/<call_id> per call. Empty = WS path unreachable
# (HTTP answer XML + tool APIs still work).
VOICE_WS_BASE_URL=""
# Resend transactional email for the agent send-email tool. Leave empty to
# keep the demo behavior (logged only, response carries demo: true). Values
# come from https://resend.com/api-keys (API key) and a verified sender
# (e.g. "Voic <onboarding@resend.dev>" in dev, your own domain in prod).
# Never commit real values.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
